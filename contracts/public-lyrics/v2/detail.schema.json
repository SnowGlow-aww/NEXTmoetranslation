{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detail.schema.json",
  "title": "NEXTmoetranslation public lyrics detail v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "musicId", "revision", "updatedAt", "state", "attributions", "availableVersions", "lines"],
  "properties": {
    "version": { "const": 2 },
    "musicId": { "type": "integer", "minimum": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "state": { "enum": ["complete", "game_only"] },
    "attributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "title", "revisionId", "revisionUrl", "licenseName", "licenseUrl"],
        "properties": {
          "provider": { "enum": ["vocaloid_fandom", "moegirl", "moegirl_public_exact", "sekaipedia"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "revisionId": { "type": "integer", "minimum": 1 },
          "revisionUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "licenseName": { "type": "string", "minLength": 1, "maxLength": 512 },
          "licenseUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "allOf": [
          {
            "if": { "properties": { "provider": { "const": "vocaloid_fandom" } }, "required": ["provider"] },
            "then": {
              "properties": {
                "licenseName": { "const": "CC BY-SA 3.0" },
                "licenseUrl": { "const": "https://creativecommons.org/licenses/by-sa/3.0/" }
              }
            }
          },
          {
            "if": {
              "properties": { "provider": { "enum": ["moegirl", "moegirl_public_exact"] } },
              "required": ["provider"]
            },
            "then": {
              "properties": {
                "licenseName": { "const": "CC BY-NC-SA 3.0" },
                "licenseUrl": { "const": "https://creativecommons.org/licenses/by-nc-sa/3.0/" }
              }
            }
          },
          {
            "if": { "properties": { "provider": { "const": "sekaipedia" } }, "required": ["provider"] },
            "then": {
              "properties": {
                "licenseName": { "const": "CC BY-SA 4.0" },
                "licenseUrl": { "const": "https://creativecommons.org/licenses/by-sa/4.0/" }
              }
            }
          }
        ]
      }
    },
    "translationCredits": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "translation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
        },
        "proofreading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
        }
      },
      "anyOf": [
        { "required": ["translation"] },
        { "required": ["proofreading"] }
      ]
    },
    "availableVersions": {
      "oneOf": [
        { "const": ["full"] },
        { "const": ["full", "game"] },
        { "const": ["game"] }
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "japanese", "zh-CN", "en-US", "segments"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "order": { "type": "integer", "minimum": 0 },
          "japanese": { "type": "string", "minLength": 1, "maxLength": 16384 },
          "zh-CN": { "type": "string", "maxLength": 16384 },
          "en-US": { "type": "string", "maxLength": 16384 },
          "stanzaBreakBefore": { "type": "boolean" },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "performerIds", "ruby"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
                "performerIds": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "ruby": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "properties": {
                      "text": { "type": "string", "minLength": 1, "maxLength": 16384 },
                      "reading": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "pattern": "^[ぁ-ゖァ-ヺー・゙゚]+$"
                      }
                    }
                  }
                }
              }
            }
          },
          "trailingPerformerIds": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "gameProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "lineIds"],
      "properties": {
        "reasonCode": {
          "enum": ["tagged_full_and_game", "untagged_uncut_identity"]
        },
        "lineIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "complete" } }, "required": ["state"] },
      "then": {
        "properties": {
          "availableVersions": {
            "oneOf": [
              { "const": ["full"] },
              { "const": ["full", "game"] }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "game_only" } }, "required": ["state"] },
      "then": {
        "properties": { "availableVersions": { "const": ["game"] } },
        "not": { "required": ["gameProjection"] }
      }
    },
    {
      "if": {
        "properties": { "availableVersions": { "const": ["full", "game"] } },
        "required": ["availableVersions"]
      },
      "then": { "required": ["gameProjection"] },
      "else": { "not": { "required": ["gameProjection"] } }
    }
  ]
}
